<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.github.jinahya</groupId>
  <artifactId>egovframe-common-components-spring-boot</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>${project.artifactId}</name>
  <description>eGovFrame common components, headless, for Spring Boot</description>
  <url>https://github.com/jinahya/${project.artifactId}</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Jinahya, Inc.</name>
    <url>https://jinahya.com</url>
  </organization>
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>onacit</id>
      <name>Kwon, Jin</name>
      <email>onacit@gmail.com</email>
      <url>https://github.com/onacit</url>
      <roles>
        <role>developer</role>
      </roles>
      <timezone>Asia/Seoul</timezone>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git@github.com:jinahya/${project.artifactId}.git</connection>
    <developerConnection>scm:git:git@github.com:jinahya/${project.artifactId}.git</developerConnection>
    <url>https://github.com/jinahya/${project.artifactId}</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jinahya/${project.artifactId}/issues</url>
  </issueManagement>

  <!--
    The eGovFrame runtime (org.egovframe.rte:*), its parent POMs (org.egovframe.web) and
    egovframework.com.ems:sndng-mail exist on no public host but https://maven.egovframe.go.kr/maven/.
    Nothing of them is on Maven Central.

    repository/ is a git-managed copy of exactly what this project needs from that host, so the
    build does not depend on it being reachable. It is listed first; the host is the fallback for
    anything not yet mirrored. mirror/pom.xml refills it; run that once per eGovFrame version and
    commit the result.

    The host publishes no maven-metadata.xml, so every eGovFrame version is pinned explicitly,
    never a range. It answers 400 to clients without a User-Agent, which Maven always sends.
    -->
  <repositories>
    <repository>
      <id>egovframe-local</id>
      <url>file://${maven.multiModuleProjectDirectory}/repository</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
    <repository>
      <id>egovframe</id>
      <url>https://maven.egovframe.go.kr/maven/</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <!-- Build order matters only for the reactor; consumers see four artifacts and a parent. -->
  <modules>
    <module>egovframe-common-components</module>
    <module>egovframe-common-components-schema</module>
    <module>egovframe-common-components-spring-boot-autoconfigure</module>
    <module>egovframe-common-components-spring-boot-starter</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!--
      17 is upstream's floor (egovframe-web-config-parent: java.version 17) and what Spring Boot 3.5
      and 4 both run on. Built on a newer JDK; the class files stay at 17.
      -->
    <maven.compiler.release>17</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>

    <!--
      The pair this build is made for. The components tag fixes the parent and runtime versions
      (its pom names egovframe-web-config-parent; that parent fixes egovframe.rte.version). When
      the submodule moves to a new tag, read the parent version from its pom and update these
      three, plus mirror/pom.xml, then rerun the mirror and commit repository/.
      -->
    <egovframe.common-components.version>5.0.7</egovframe.common-components.version>
    <egovframe.web.version>5.0.2</egovframe.web.version>
    <egovframe.rte.version>5.0.2</egovframe.rte.version>

    <!--
      Boot 3.5: the line whose Spring Framework (6.2) and Spring Security (6.5) are what RTE 5.0.x
      is compiled against. Boot 4 (Spring 7) is untested with RTE 5.0.
      https://docs.spring.io/spring-boot/appendix/dependency-versions/coordinates.html
      -->
    <version.org.springframework.boot>3.5.16</version.org.springframework.boot>
  </properties>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-compiler-plugin/versions -->
          <version>3.15.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-jar-plugin/versions -->
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-resources-plugin/versions -->
          <version>3.4.0</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.codehaus.mojo/build-helper-maven-plugin/versions -->
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.codehaus.mojo/exec-maven-plugin/versions -->
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <!-- https://central.sonatype.com/artifact/org.apache.maven.plugins/maven-surefire-plugin/versions -->
          <version>3.5.4</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>

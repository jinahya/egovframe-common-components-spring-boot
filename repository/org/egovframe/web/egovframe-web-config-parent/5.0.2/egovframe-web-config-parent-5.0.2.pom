        <commons-lang3.version>3.18.0</commons-lang3.version>
        <commons-net.version>3.11.1</commons-net.version>
        <commons-pool2.version>2.12.1</commons-pool2.version>

        <!-- Database -->
        <mysql-connector-j.version>8.4.0</mysql-connector-j.version>
        <mariadb-java-client.version>3.4.0</mariadb-java-client.version>
        <postgresql.version>42.7.3</postgresql.version>
        <hsqldb.version>2.7.4</hsqldb.version>

        <!-- Validation, JSON, XML -->
        <hibernate-validator.version>8.0.3.Final</hibernate-validator.version>
        <yasson.version>3.0.4</yasson.version>
        <parsson.version>1.1.7</parsson.version>
        <xmlbeans.version>5.3.0</xmlbeans.version>
        <antlr4.version>4.13.2</antlr4.version>

        <!-- Utilities -->
        <cglib.version>3.3.0</cglib.version>
        <jasypt.version>1.9.3</jasypt.version>
        <icu4j.version>77.1</icu4j.version>
        <quartz.version>2.5.0</quartz.version>
        <oro.version>2.0.8</oro.version>
        <selenium.version>4.38.0</selenium.version>

        <!-- HTTP, Web Services -->
        <httpclient5.version>5.5.1</httpclient5.version>
        <jaxws-rt.version>4.0.2</jaxws-rt.version>
        <jaxrpc-impl.version>1.1.6</jaxrpc-impl.version>
        <jaxrpc-api-osgi.version>1.1-b01</jaxrpc-api-osgi.version>
        <jms-api.version>1.1-rev-1</jms-api.version>
        <servicemix.jaxws-api.version>2.9.0</servicemix.jaxws-api.version>

        <!-- UI, Editor -->
        <ckeditor-java-core.version>3.5.3</ckeditor-java-core.version>
        <batik-ext.version>1.17</batik-ext.version>
        <ajaxtags-resources.version>1.5.7</ajaxtags-resources.version>

        <!-- JSON, Converter -->
        <jodconverter.version>2.2.1</jodconverter.version>
        <json-simple.version>1.1.1</json-simple.version>
        <json-lib.version>2.4</json-lib.version>


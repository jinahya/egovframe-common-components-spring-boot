<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.egovframe.web</groupId>
    <artifactId>egovframe-web-config-parent</artifactId>
    <version>5.0.2</version>
    <packaging>pom</packaging>
    <name>egovframe-web-config-parent</name>
    <description>The eGovernment Standard Framework</description>
    <url>https://www.egovframe.go.kr</url>

    <licenses>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- eGovFrame -->
        <egovframe.rte.version>5.0.2</egovframe.rte.version>

        <!-- Spring -->
        <spring.framework.version>6.2.11</spring.framework.version>

        <!-- Jakarta -->
		<jakarta.annotation-api.version>3.0.0</jakarta.annotation-api.version>
        <jakarta.servlet-api.version>5.0.0</jakarta.servlet-api.version>
        <jakarta.servlet.jsp-api.version>4.0.0</jakarta.servlet.jsp-api.version>
        <jakarta.servlet.jsp.jstl-api.version>3.0.2</jakarta.servlet.jsp.jstl-api.version>
        <jakarta.servlet.jsp.jstl.version>3.0.1</jakarta.servlet.jsp.jstl.version>
        <jakarta.validation-api.version>3.1.1</jakarta.validation-api.version>
        <jakarta.websocket-api.version>2.2.0</jakarta.websocket-api.version>
        <jakarta.faces-api.version>4.1.2</jakarta.faces-api.version>
        <jakarta.inject-api.version>2.0.1</jakarta.inject-api.version>
        <jakarta.json-api.version>2.1.3</jakarta.json-api.version>
        <jakarta.mail.version>2.0.2</jakarta.mail.version>
        <jakarta.json.version>2.0.1</jakarta.json.version>

        <!-- Jackson -->
        <jackson.version>2.18.2</jackson.version>

        <!-- Logging -->
        <log4j2.version>2.25.3</log4j2.version>
		<slf4j.version>2.0.17</slf4j.version>
        <log4jdbc.version>1.2</log4jdbc.version>

        <!-- Apache Commons -->
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <commons-codec.version>1.18.0</commons-codec.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <commons-dbcp2.version>2.13.0</commons-dbcp2.version>
        <commons-email.version>1.6.0</commons-email.version>
        <commons-email2-jakarta.version>2.0.0-M1</commons-email2-jakarta.version>
        <commons-fileupload2-jakarta-servlet6.version>2.0.0-M5</commons-fileupload2-jakarta-servlet6.version>

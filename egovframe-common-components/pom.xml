    <!--
      Proprietary SMS gateway client bundled in upstream's WEB-INF/lib (groupId "project"), used by
      cop.sms only. Optional: it is not redistributable, so consumers who want cop.sms supply it.
      Resolved from the submodule through the profile below.
      -->
    <dependency>
      <groupId>project</groupId>
      <artifactId>smeapi</artifactId>
      <version>2.7.0</version>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <profiles>
    <!--
      Upstream's WEB-INF/lib is laid out as a Maven repository (project:<artifactId>:<version>).
      Active only where the submodule is checked out, so the file:// URL never applies to a consumer
      resolving the published pom.
      -->
    <profile>
      <id>upstream-bundled-jars</id>
      <activation>
        <file>
          <exists>${basedir}/../upstream/egovframe-common-components/src/main/webapp/WEB-INF/lib</exists>
        </file>
      </activation>
      <repositories>
        <repository>
          <id>upstream-bundled-jars</id>
          <url>file://${basedir}/../upstream/egovframe-common-components/src/main/webapp/WEB-INF/lib</url>
          <releases>
            <checksumPolicy>ignore</checksumPolicy>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <build>
    <plugins>
      <!-- upstream's sources and resources, read in place from the submodule -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-upstream-source</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${upstream.dir}/src/main/java</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-upstream-resources</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>add-resource</goal>
            </goals>
            <configuration>
              <resources>
                <resource>
                  <directory>${upstream.dir}/src/main/resources</directory>
                </resource>
                <!-- upstream's own LICENSE file, as is -->
                <resource>
                  <directory>${upstream.dir}</directory>
                  <includes>
                    <include>LICENSE</include>
                  </includes>
                  <targetPath>META-INF</targetPath>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!--
        Remove one directory entry from the jar: egovframework/com/cmm/service/.

        Upstream's static EgovProperties locates globals.properties through
        EgovProperties.class.getResource(""), i.e. the class loader's resource for that directory.
        Upstream deploys as an exploded WAR, where that is a real directory and the file sits next to
        it. From a jar it is a jar: URL, which EgovProperties then opens with FileInputStream, and
        every class touching Globals fails to initialize. Without that single directory entry the
        resource is null and upstream falls back to egovProps/globals.properties relative to the
        working directory, which the auto-configuration materializes. Every other directory entry
        stays, so classpath*: scanning into the jar keeps working.

        A single-file Java program (JEP 330) run by the JVM Maven runs on; no extra toolchain.
        -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>strip-service-directory-entry</id>
            <phase>package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <arguments>
                <argument>${project.basedir}/../tools/StripJarEntries.java</argument>
                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                <argument>egovframework/com/cmm/service/</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

